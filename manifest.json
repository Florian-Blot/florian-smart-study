<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#101629">
<title>FLORIAN SMART STUDY</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #101629;
    color: white;
    padding-bottom: 90px;
}

header {
    padding: 25px 20px;
    background: linear-gradient(135deg,#172b50,#284b83);
    border-radius: 0 0 25px 25px;
}

header h1 {
    font-size: 23px;
    color: #64d9ff;
}

header p {
    margin-top: 8px;
    color: #c7d5eb;
}

.container {
    padding: 18px;
}

.clock {
    text-align: center;
    padding: 20px;
    background: #1b2944;
    border-radius: 18px;
    margin-bottom: 20px;
}

#time {
    font-size: 35px;
    font-weight: bold;
    color: #64d9ff;
}

#date {
    margin-top: 7px;
    color: #aebdd4;
}

.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.card {
    background: #1b2944;
    padding: 18px;
    border-radius: 16px;
    min-height: 105px;
}

.card h3 {
    font-size: 15px;
    margin-bottom: 10px;
}

.card p {
    color: #64d9ff;
    font-size: 22px;
    font-weight: bold;
}

.section {
    display: none;
    margin-top: 20px;
}

.section.active {
    display: block;
}

h2 {
    margin-bottom: 16px;
    color: #64d9ff;
}

input, select {
    width: 100%;
    padding: 13px;
    border: none;
    border-radius: 10px;
    margin: 7px 0;
    background: #263653;
    color: white;
}

button {
    background: #168ac2;
    color: white;
    border: none;
    padding: 12px;
    border-radius: 10px;
    margin-top: 8px;
    cursor: pointer;
    font-weight: bold;
}

button:active {
    opacity: .7;
}

.item {
    background: #1b2944;
    padding: 14px;
    margin: 9px 0;
    border-radius: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
}

.item button {
    margin: 0;
    background: #b53d54;
}

nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #17233a;
    display: flex;
    justify-content: space-around;
    padding: 12px 3px;
    border-top: 1px solid #314361;
}

nav button {
    background: transparent;
    font-size: 11px;
    padding: 5px;
    margin: 0;
}

.timer {
    text-align: center;
    font-size: 45px;
    margin: 25px 0;
    color: #64d9ff;
}

.progress {
    background: #34445e;
    height: 12px;
    border-radius: 20px;
    margin-top: 12px;
    overflow: hidden;
}

#bar {
    height: 100%;
    width: 0%;
    background: #31d7a0;
    transition: .3s;
}

.small {
    color: #aebdd4;
    font-size: 13px;
}

</style>
</head>

<body>

<header>
<h1>FLORIAN SMART STUDY</h1>
<p>Ton assistant universitaire personnel</p>
</header>

<div class="container">

<div class="clock">
<div id="time">00:00:00</div>
<div id="date"></div>
</div>

<div id="home" class="section active">
<h2>Tableau de bord</h2>

<div class="grid">
<div class="card">
<h3>📚 Matières</h3>
<p id="subjectCount">0</p>
</div>

<div class="card">
<h3>📝 Tâches</h3>
<p id="taskCount">0</p>
</div>

<div class="card">
<h3>⏱️ Temps étudié</h3>
<p id="studyTime">0 min</p>
</div>

<div class="card">
<h3>🎯 Objectif quotidien</h3>
<p>2 heures</p>
</div>
</div>

<br>
<h2>Progression quotidienne</h2>
<div class="progress">
<div id="bar"></div>
</div>
<p class="small" id="progressText">0 % de ton objectif atteint</p>

<br>
<h2>Bienvenue dans ton espace de travail !</h2>
<p class="small">Organise tes cours, programme tes révisions et suis tes progrès.</p>
</div>

<div id="subjects" class="section">
<h2>📚 Mes matières</h2>
<input id="subjectInput" placeholder="Nom de la matière">
<button onclick="addSubject()">Ajouter une matière</button>
<div id="subjectList"></div>
</div>

<div id="tasks" class="section">
<h2>📝 Mes tâches</h2>
<input id="taskInput" placeholder="Ex : Réviser la biologie">
<input id="taskDate" type="datetime-local">
<button onclick="addTask()">Ajouter une tâche</button>
<div id="taskList"></div>
</div>

<div id="timerSection" class="section">
<h2>⏱️ Chronomètre de révision</h2>
<div class="timer" id="timer">00:00:00</div>

<button onclick="startTimer()">▶ Démarrer</button>
<button onclick="pauseTimer()">⏸ Pause</button>
<button onclick="resetTimer()">↻ Réinitialiser</button>

<p class="small" style="margin-top:15px">
Le temps de travail est enregistré automatiquement lorsque tu termines une séance.
</p>
</div>

<div id="schedule" class="section">
<h2>📅 Emploi du temps</h2>
<input id="courseName" placeholder="Nom du cours">
<select id="courseDay">
<option>Lundi</option>
<option>Mardi</option>
<option>Mercredi</option>
<option>Jeudi</option>
<option>Vendredi</option>
<option>Samedi</option>
<option>Dimanche</option>
</select>
<input id="courseTime" type="time">
<button onclick="addCourse()">Ajouter au programme</button>
<div id="courseList"></div>
</div>

<div id="reminders" class="section">
<h2>🔔 Rappels</h2>
<p class="small">Autorise les notifications pour recevoir tes rappels lorsque l'application est ouverte.</p>
<input id="reminderText" placeholder="Texte du rappel">
<input id="reminderDate" type="datetime-local">
<button onclick="addReminder()">Programmer un rappel</button>
<div id="reminderList"></div>
</div>

</div>

<nav>
<button onclick="show('home')">🏠<br>Accueil</button>
<button onclick="show('subjects')">📚<br>Matières</button>
<button onclick="show('tasks')">📝<br>Tâches</button>
<button onclick="show('timerSection')">⏱️<br>Timer</button>
<button onclick="show('schedule')">📅<br>Cours</button>
<button onclick="show('reminders')">🔔<br>Rappels</button>
</nav>

<script>

const getData = (key) => {
    try {
        return JSON.parse(localStorage.getItem(key)) || [];
    } catch {
        return [];
    }
};

let subjects = getData("subjects");
let tasks = getData("tasks");
let courses = getData("courses");
let reminders = getData("reminders");

let seconds = 0;
let interval = null;
let totalStudy = Number(localStorage.getItem("totalStudy")) || 0;

function save() {
    localStorage.setItem("subjects", JSON.stringify(subjects));
    localStorage.setItem("tasks", JSON.stringify(tasks));
    localStorage.setItem("courses", JSON.stringify(courses));
    localStorage.setItem("reminders", JSON.stringify(reminders));
}

function show(id) {
    document.querySelectorAll(".section").forEach(s => {
        s.classList.remove("active");
    });

    document.getElementById(id).classList.add("active");
}

function updateClock() {
    const now = new Date();

    document.getElementById("time").textContent =
        now.toLocaleTimeString("fr-FR");

    document.getElementById("date").textContent =
        now.toLocaleDateString("fr-FR", {
            weekday: "long",
            day: "numeric",
            month: "long",
            year: "numeric"
        });
}

setInterval(updateClock, 1000);
updateClock();

function addSubject() {
    const input = document.getElementById("subjectInput");
    const value = input.value.trim();

    if (!value) return;

    subjects.push(value);
    input.value = "";
    save();
    render();
}

function addTask() {
    const input = document.getElementById("taskInput");
    const value = input.value.trim();

    if (!value) return;

    tasks.push({
        name: value,
        date: document.getElementById("taskDate").value,
        done: false
    });

    input.value = "";
    save();
    render();
}

function addCourse() {
    const name = document.getElementById("courseName").value.trim();
    const day = document.getElementById("courseDay").value;
    const time = document.getElementById("courseTime").value;

    if (!name || !time) return;

    courses.push({name, day, time});
    document.getElementById("courseName").value = "";

    save();
    render();
}

function addReminder() {
    const name = document.getElementById("reminderText").value.trim();
    const date = document.getElementById("reminderDate").value;

    if (!name || !date || new Date(date) <= new Date()) {
        alert("Entre un rappel et une date future valide.");
        return;
    }

    reminders.push({
        name,
        date,
        sent: false
    });

    document.getElementById("reminderText").value = "";
    save();
    render();
}

function deleteItem(type, index) {
    if (type === "subjects") subjects.splice(index, 1);
    if (type === "tasks") tasks.splice(index, 1);
    if (type === "courses") courses.splice(index, 1);
    if (type === "reminders") reminders.splice(index, 1);

    save();
    render();
}

function completeTask(index) {
    tasks[index].done = !tasks[index].done;
    save();
    render();
}

function startTimer() {
    if (interval) return;

    interval = setInterval(() => {
        seconds++;
        document.getElementById("timer").textContent = formatTime(seconds);
    }, 1000);
}

function pauseTimer() {
    if (interval) {
        clearInterval(interval);
        interval = null;
    }
}

function resetTimer() {
    pauseTimer();

    if (seconds > 0) {
        totalStudy += seconds;
        localStorage.setItem("totalStudy", totalStudy);
    }

    seconds = 0;
    document.getElementById("timer").textContent = "00:00:00";
    render();
}

function formatTime(value) {
    const h = Math.floor(value / 3600);
    const m = Math.floor((value % 3600) / 60);
    const s = value % 60;

    return [h,m,s].map(v => String(v).padStart(2,"0")).join(":");
}

function checkReminders() {
    const now = Date.now();

    reminders.forEach(reminder => {
        if (!reminder.sent && new Date(reminder.date).getTime() <= now) {
            reminder.sent = true;

            if ("Notification" in window &&
                Notification.permission === "granted") {
                new Notification("FLORIAN SMART STUDY", {
                    body: reminder.name
                });
            } else {
                alert("Rappel : " + reminder.name);
            }

            save();
            render();
        }
    });
}

function render() {
    document.getElementById("subjectList").innerHTML =
        subjects.map((s,i) => `
        <div class="item">
        <span>${escapeHTML(s)}</span>
        <button onclick="deleteItem('subjects',${i})">Supprimer</button>
        </div>`).join("");

    document.getElementById("taskList").innerHTML =
        tasks.map((t,i) => `
        <div class="item">
        <span onclick="completeTask(${i})">
        ${t.done ? "✅" : "⬜"} ${escapeHTML(t.name)}
        ${t.date ? "<br><small>"+escapeHTML(t.date)+"</small>" : ""}
        </span>
        <button onclick="deleteItem('tasks',${i})">×</button>
        </div>`).join("");

    document.getElementById("courseList").innerHTML =
        courses.map((c,i) => `
        <div class="item">
        <span>${escapeHTML(c.day)} - ${escapeHTML(c.time)}<br>${escapeHTML(c.name)}</span>
        <button onclick="deleteItem('courses',${i})">×</button>
        </div>`).join("");

    document.getElementById("reminderList").innerHTML =
        reminders.map((r,i) => `
        <div class="item">
        <span>${escapeHTML(r.name)}<br><small>${escapeHTML(r.date)}</small></span>
        <button onclick="deleteItem('reminders',${i})">×</button>
        </div>`).join("");

    document.getElementById("subjectCount").textContent = subjects.length;
    document.getElementById("taskCount").textContent =
        tasks.filter(t => !t.done).length;

    const minutes = Math.floor(totalStudy / 60);
    document.getElementById("studyTime").textContent = minutes + " min";

    const progress = Math.min(100, minutes / 120 * 100);
    document.getElementById("bar").style.width = progress + "%";
    document.getElementById("progressText").textContent =
        Math.round(progress) + "% de ton objectif atteint";
}

function escapeHTML(value) {
    return String(value).replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[char]);
}

if ("Notification" in window && Notification.permission === "default") {
    Notification.requestPermission();
}

setInterval(checkReminders, 10000);

render();

</script>

</body>
</html>